    {
      "type": "stat",
      "title": "web",
      "description": "All requests pass through web, so web is every route combined. Requests/s, 5xx error %, p95 latency. Measured by Traefik, which sits in front of web with one route per API (Robot Shop services do not report these numbers themselves). Latency buckets stop at 10 s, so a value of 10 s means 10 s or more (payment calls an external gateway and often reaches this).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
