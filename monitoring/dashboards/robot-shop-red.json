{
  "uid": "robot-shop-red",
  "title": "Robot Shop: requests, errors and latency",
  "description": "Capstone 2 dashboard. Request rate, 5xx errors and latency per API (from Traefik) plus Kubernetes health for the robot-shop namespace.",
  "tags": [
    "robot-shop",
    "capstone",
    "red"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "current": {
          "text": "robot-shop",
          "value": "robot-shop"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Summary",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests per second (all APIs)",
      "description": "Measured by Traefik, which sits in front of web with one route per API (Robot Shop services do not report these numbers themselves).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(traefik_router_requests_total{router=~\"robot-shop-.*\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "5xx error rate (all APIs)",
      "description": "Share of responses with a 5xx status. Measured by Traefik, which sits in front of web with one route per API (Robot Shop services do not report these numbers themselves).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (sum(rate(traefik_router_requests_total{router=~\"robot-shop-.*\",code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(traefik_router_requests_total{router=~\"robot-shop-.*\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "payment p95 latency",
      "description": "95th percentile response time of /api/payment. Latency buckets stop at 10 s, so a value of 10 s means 10 s or more (payment calls an external gateway and often reaches this).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_router_request_duration_seconds_bucket{router=\"robot-shop-robot-shop-api-payment@kubernetes\"}[$__rate_interval])))",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Containers ready",
      "description": "Share of Robot Shop containers whose readiness probe passes (kube-state-metrics).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum(kube_pod_container_status_ready{namespace=\"$namespace\"}) / count(kube_pod_container_status_ready{namespace=\"$namespace\"})",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Requests, errors and latency per API (Traefik)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per second by API",
      "description": "Measured by Traefik, which sits in front of web with one route per API (Robot Shop services do not report these numbers themselves).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (api) (label_replace(label_replace(sum by (router) (rate(traefik_router_requests_total{router=~\"robot-shop-.*\"}[$__rate_interval])), \"api\", \"$1\", \"router\", \"robot-shop-robot-shop-api-(.+)@kubernetes\"), \"api\", \"web-ui\", \"router\", \"robot-shop-robot-shop@kubernetes\"))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{api}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "5xx error rate by API",
      "description": "Share of responses with a 5xx status per API; 0 when there were no 5xx responses. Measured by Traefik, which sits in front of web with one route per API (Robot Shop services do not report these numbers themselves).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum by (api) (label_replace(label_replace((sum by (router) (rate(traefik_router_requests_total{router=~\"robot-shop-.*\",code=~\"5..\"}[$__rate_interval])) or (sum by (router) (rate(traefik_router_requests_total{router=~\"robot-shop-.*\"}[$__rate_interval])) * 0)), \"api\", \"$1\", \"router\", \"robot-shop-robot-shop-api-(.+)@kubernetes\"), \"api\", \"web-ui\", \"router\", \"robot-shop-robot-shop@kubernetes\")) / sum by (api) (label_replace(label_replace(sum by (router) (rate(traefik_router_requests_total{router=~\"robot-shop-.*\"}[$__rate_interval])), \"api\", \"$1\", \"router\", \"robot-shop-robot-shop-api-(.+)@kubernetes\"), \"api\", \"web-ui\", \"router\", \"robot-shop-robot-shop@kubernetes\"))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{api}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "p50 latency by API",
