          "expr": "histogram_quantile(0.5, sum by (api, le) (label_replace(label_replace(sum by (router, le) (rate(traefik_router_request_duration_seconds_bucket{router=~\"robot-shop-.*\"}[$__rate_interval])), \"api\", \"$1\", \"router\", \"robot-shop-robot-shop-api-(.+)@kubernetes\"), \"api\", \"web-ui\", \"router\", \"robot-shop-robot-shop@kubernetes\")))",
          "refId": "A",
